# Frontal Lobe UI — public env vars (safe to commit).
# Copy this file to .env.local for local dev.

# Base URL of the Frontal Lobe Relate API (FastAPI microservice, llm_app/main.py).
# Dev default: http://localhost:8020 (Relate backend — 8010 is Memgraph, 8000 the original).
VITE_API_BASE=http://localhost:8020

# Optional — only needed if the UI gets a "Sync now" button that calls n8n.
# VITE_N8N_BASE_URL=https://n8n.airpg.ai