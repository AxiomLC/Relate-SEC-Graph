# ── Relate store ──────────────────────────────────────────────
# A DIRECTORY store (not a .rl file). Ships pre-built in data/graph/.
RELATE_DB_PATH=./data/graph
RELATE_READ_ONLY=1

# ── backend ───────────────────────────────────────────────────
PORT=8020
CORS_ORIGINS=http://localhost:5188

# ── semantic search (optional) ────────────────────────────────
# The 3D map and Cypher need NO key. Semantic search embeds the query with
# text-embedding-3-small, so it needs this.
OPENAI_API_KEY=
